# ==========================================
# EZ-ZAHRAOUI IT Guardian - Environment Template
# Copy this file to .env and fill in real values
# ==========================================

# --- Database ---
DATABASE_URL=postgresql://guardian:guardian_password@localhost:5432/it_guardian
POSTGRES_USER=guardian
POSTGRES_PASSWORD=guardian_password
POSTGRES_DB=it_guardian

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true
SECRET_KEY=change_this_to_a_random_string_in_production

# --- Monitoring ---
MONITORING_INTERVAL_SECONDS=60
MONITORING_TIMEOUT_SECONDS=5
MONITORING_PING_COUNT=4

# --- Frontend ---
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# --- AI / Ollama (Phase 11) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Azure (Phase 14) ---
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
